DIST_DIR=./dist
PRESENTATION_URL=http://localhost:8000
REPOSITORY_URL=file://./
# CURRENT_UID is computed by the Makefile (id -u:id -g) so the build
# containers write dist/ as the user invoking make. Do not pin it to 0
# here: root-owned files in dist/ cannot be removed by `make clean`.
# See issue #514.
BUILD_DIR=/tmp/dist
