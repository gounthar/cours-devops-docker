# Utiliser Alpine ou Debian comme image de base
FROM alpine

# Installer nginx sans garder l'index des paquets
RUN apk add --no-cache nginx

# Exposer le port 80
EXPOSE 80

# Ajouter le fichier HTML (à récupérer depuis l'image de Jean-Michel)
COPY html/index.html /usr/share/nginx/html/

# Définir le point d'entrée pour lancer nginx
ENTRYPOINT ["nginx", "-g", "daemon off;"]
